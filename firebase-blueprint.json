  "firestore": {
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Registry of authorized administrators"
    },
    "/site_settings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Global project settings"
    },
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Permanent room and section metadata"
    },
    "/history_periods/{historyPeriodId}": {
      "schema": "HistoryPeriod",
      "description": "Historical development periods"
    },
    "/timeline_events/{timelineEventId}": {
      "schema": "TimelineEvent",
      "description": "1966-2026 Orbital timeline events"
    },
    "/development_milestones/{milestoneId}": {
      "schema": "DevelopmentMilestone",
      "description": "School development and facility milestones"
    },
    "/artifacts/{artifactId}": {
      "schema": "Artifact",
      "description": "Historical artifacts and relic documentation"
    },
    "/achievements/{achievementId}": {
      "schema": "Achievement",
      "description": "School awards, academic achievements, and honors"
    },
    "/people/{personId}": {
      "schema": "Person",
      "description": "Principals, teachers, staff, and notable alumni"
    },
    "/memories/{memoryId}": {
      "schema": "Memory",
      "description": "Remembrance articles, memories, and alumni stories"
    },
    "/news_events/{newsEventId}": {
      "schema": "NewsEvent",
      "description": "School news, 60-year anniversary announcements and activities"
    },
    "/digital_resources/{resourceId}": {
      "schema": "DigitalResource",
      "description": "Digital archives, podcasts, reference files"
    },
    "/hotspots/{hotspotId}": {
      "schema": "Hotspot",
      "description": "Exhibition room interactive hotspot content"
    },
    "/sources/{sourceId}": {
      "schema": "Source",
      "description": "Authoritative historical sources and citations"
    },
    "/licenses/{licenseId}": {
      "schema": "License",
      "description": "Asset copyright, licensing and AI transparency records"
    },
    "/media_assets/{mediaAssetId}": {
      "schema": "MediaAsset",
      "description": "Media file metadata in Firebase Storage"
    },
    "/credits/{creditId}": {
      "schema": "Credit",
      "description": "Project contributors and school acknowledgments"
    },
    "/editorial_contents/{contentId}": {
      "schema": "EditorialContent",
      "description": "Direct editable 2-layer content records across the museum"
    }
  }
}

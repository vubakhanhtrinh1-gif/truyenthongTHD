      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "Admin email address" },
        "role": { "type": "string", "enum": ["ADMIN"], "description": "RBAC Role" },
        "displayName": { "type": "string", "description": "Display name" },
        "isActive": { "type": "boolean", "description": "Whether administrator is active" },
